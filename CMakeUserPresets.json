{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 26
	},
	"configurePresets": [
		{
			"name": "Windows",
			"hidden": false,
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++"
			}
		},
		{
			"name": "Linux",
			"hidden": false,
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		}
	],
	"buildPresets": [
		{
			"name": "Debug (Linux)",
			"configuration": "Debug",
            "jobs": 6,
            "configurePreset": "Linux"
		},
		{
			"name": "Release (Linux)",
			"configuration": "Release",
            "jobs": 6,
            "configurePreset": "Linux"
		},
		{
			"name": "Debug (Linux, clean)",
			"configuration": "Debug",
            "jobs": 6,
			"cleanFirst": true,
            "configurePreset": "Linux"
		},
		{
			"name": "Release (Linux, clean)",
			"configuration": "Release",
            "jobs": 6,
			"cleanFirst": true,
            "configurePreset": "Linux"
		},
		{
			"name": "Debug (Windows)",
			"configuration": "Debug",
            "jobs": 6,
            "configurePreset": "Windows"
		},
		{
			"name": "Release (Windows)",
			"configuration": "Release",
            "jobs": 6,
            "configurePreset": "Windows"
		},
		{
			"name": "Debug (Windows, clean)",
			"configuration": "Debug",
            "jobs": 6,
			"cleanFirst": true,
            "configurePreset": "Windows"
		},
		{
			"name": "Release (Windows, clean)",
			"configuration": "Release",
            "jobs": 6,
			"cleanFirst": true,
            "configurePreset": "Windows"
		}
	]
}